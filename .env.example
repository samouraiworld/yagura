# Copy to .env and adjust. Every secret variable X can also be given as
# X_FILE, the path of a file holding the value (re-read on each poll).

# Address the HTTP server listens on.
#YAGURA_LISTEN_ADDRESS=:10100

# Path of an exporter-toolkit web configuration file (TLS, basic auth).
#YAGURA_WEB_CONFIG_FILE=

# Log level: debug, info, warn or error.
#YAGURA_LOG_LEVEL=info

# Log format: logfmt or json.
#YAGURA_LOG_FORMAT=logfmt

# Statuspage collector (no credentials needed). Set to false to disable.
#YAGURA_STATUSPAGE_ENABLED=true

# Comma-separated name=baseURL list; replaces the default list of four
# public pages (Supabase, Scaleway, Netlify, Gandi). Names: [a-z0-9_]+.
#YAGURA_STATUSPAGE_PAGES=supabase=https://status.supabase.com,scaleway=https://status.scaleway.com,netlify=https://www.netlifystatus.com,gandi=https://status.gandi.net

# Pages appended to the list above, same format.
#YAGURA_STATUSPAGE_EXTRA_PAGES=demo=https://status.example.com

# Poll interval (minimum 30s).
#YAGURA_STATUSPAGE_INTERVAL=1m

# Gandi collector: personal access token (PAT), restricted to one
# organization, with an expiry and only the narrowest permissions that let it
# see domains and billing information (it needs both; see the README caveat).
# Setting it enables the collector.
#YAGURA_GANDI_TOKEN=
#YAGURA_GANDI_TOKEN_FILE=/run/secrets/gandi_token

# Organization ID (UUID): restricts the domain list to it and reads its billing
# account. Empty uses the token's default scope.
#YAGURA_GANDI_SHARING_ID=00000000-0000-0000-0000-000000000001

# Poll intervals (minimum 30s).
#YAGURA_GANDI_DOMAINS_INTERVAL=6h
#YAGURA_GANDI_BILLING_INTERVAL=1h

# Renewal prices: on by default; once a day, a domain listing plus one request
# per 50 distinct TLDs. Set to false if the token may not read prices (the
# poller then fails with HTTP 403).
#YAGURA_GANDI_PRICES_ENABLED=true
#YAGURA_GANDI_PRICES_INTERVAL=24h

# Scaleway collector: secret key of an IAM application whose policy grants only
# the BillingReadOnly permission set on the organization, with an expiry.
# Setting it enables the collector.
#YAGURA_SCALEWAY_SECRET_KEY=
#YAGURA_SCALEWAY_SECRET_KEY_FILE=/run/secrets/scaleway_secret_key

# Organization ID (UUID) whose consumption is read. Required when the
# collector is enabled.
#YAGURA_SCALEWAY_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Poll interval (minimum 30s).
#YAGURA_SCALEWAY_INTERVAL=1h

# Supabase collector: scoped personal access token (sbp_...), created from the
# "No access" preset, restricted to the watched organization, with
# an expiry and only the Read permissions listed in the README. Setting it
# enables the collector.
#YAGURA_SUPABASE_TOKEN=
#YAGURA_SUPABASE_TOKEN_FILE=/run/secrets/supabase_token

# Services whose health is requested for each active project. Allowed: auth,
# db, db_postgres_user, pooler, realtime, rest, storage, pg_bouncer.
#YAGURA_SUPABASE_HEALTH_SERVICES=auth,db,pooler,realtime,rest,storage

# Poll intervals (minimum 30s): projects and health, then disk.
#YAGURA_SUPABASE_HEALTH_INTERVAL=1m
#YAGURA_SUPABASE_DISK_INTERVAL=5m

# Netlify collector: personal access token. Netlify tokens have no scopes and
# act with the full rights of their user on every team of that user: prefer a
# dedicated, least-privileged team member and set an expiration date (see the
# README). Setting it enables the collector.
#YAGURA_NETLIFY_TOKEN=
#YAGURA_NETLIFY_TOKEN_FILE=/run/secrets/netlify_token

# Poll intervals (minimum 30s): sites and last deploy, then build minutes.
#YAGURA_NETLIFY_DEPLOYS_INTERVAL=5m
#YAGURA_NETLIFY_BUILDS_INTERVAL=15m

# Budgets (optional). An existing directory holding budgets.json, writable by
# the container user (UID 65532) on the first start (yagura creates the file)
# and whenever the API is on. Setting it enables the store and
# yagura_budget_amount.
#YAGURA_STATE_DIR=/var/lib/yagura

# Initial budgets in EUR, excluding VAT. Applied once, only when budgets.json
# does not exist yet; ignored afterwards. No budget is set by default.
#YAGURA_BUDGET_INITIAL_TOTAL=
#YAGURA_BUDGET_INITIAL_SCALEWAY=

# Budget write API (off by default), on its own listener. Needs
# YAGURA_STATE_DIR and a random token of at least 32 characters, for example
# from `openssl rand -hex 32`. Bind it to loopback or an internal network
# only. In a container, 127.0.0.1 is the container itself: listen on :10101
# and publish the port on the host's 127.0.0.1 only (see docker-compose.yml).
#YAGURA_API_LISTEN_ADDRESS=127.0.0.1:10101
#YAGURA_API_TOKEN=
#YAGURA_API_TOKEN_FILE=/run/secrets/api_token
