# Copy to .env and adjust. Every secret variable X can also be given as
# X_FILE, the path of a file holding the value (re-read on each poll).

# Address the HTTP server listens on.
#YAGURA_LISTEN_ADDRESS=:10100

# Path of an exporter-toolkit web configuration file (TLS, basic auth).
#YAGURA_WEB_CONFIG_FILE=

# Log level: debug, info, warn or error.
#YAGURA_LOG_LEVEL=info

# Log format: logfmt or json.
#YAGURA_LOG_FORMAT=logfmt

# Statuspage collector (no credentials needed). Set to false to disable.
#YAGURA_STATUSPAGE_ENABLED=true

# Comma-separated name=baseURL list; replaces the default list of four
# public pages (Supabase, Scaleway, Netlify, Gandi). Names: [a-z0-9_]+.
#YAGURA_STATUSPAGE_PAGES=supabase=https://status.supabase.com,scaleway=https://status.scaleway.com,netlify=https://www.netlifystatus.com,gandi=https://status.gandi.net

# Pages appended to the list above, same format.
#YAGURA_STATUSPAGE_EXTRA_PAGES=demo=https://status.example.com

# Poll interval (minimum 30s).
#YAGURA_STATUSPAGE_INTERVAL=1m

# Gandi collector: personal access token (PAT), restricted to one
# organization, with an expiry and only the narrowest permissions that let it
# see domains and billing information (it needs both; see the README caveat).
# Setting it enables the collector.
#YAGURA_GANDI_TOKEN=
#YAGURA_GANDI_TOKEN_FILE=/run/secrets/gandi_token

# Organization ID (UUID): restricts the domain list to it and reads its billing
# account. Empty uses the token's default scope.
#YAGURA_GANDI_SHARING_ID=00000000-0000-0000-0000-000000000001

# Poll intervals (minimum 30s).
#YAGURA_GANDI_DOMAINS_INTERVAL=6h
#YAGURA_GANDI_BILLING_INTERVAL=1h
