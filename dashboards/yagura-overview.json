{
  "uid": "yagura-overview",
  "title": "yagura",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "yagura"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Exporter health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Collectors up",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Last success age",
      "type": "table",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "time() - yagura_collector_last_success_timestamp_seconds",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Item errors",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_last_item_errors"
        }
      ]
    },
    {
      "id": 5,
      "title": "API requests by code",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (provider, code) (rate(yagura_api_requests_total[5m]))",
          "legendFormat": "{{provider}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Provider status",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Provider indicator",
      "type": "state-timeline",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_statuspage_indicator",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "unknown",
                  "color": "purple",
                  "index": 0
                },
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                },
                "1": {
                  "text": "minor",
                  "color": "yellow",
                  "index": 2
                },
                "2": {
                  "text": "major",
                  "color": "orange",
                  "index": 3
                },
                "3": {
                  "text": "critical",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Unresolved incidents",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_statuspage_unresolved_incidents",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Domains",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Domain expiry",
      "type": "table",
      "datasource": "${datasource}",
      "description": "Days until each Gandi domain registration ends, soonest first, and whether it renews automatically.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "(yagura_gandi_domain_expiry_timestamp_seconds - time()) / 86400",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "yagura_gandi_domain_autorenew",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {
              "domain": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "domain": "Domain",
              "Value #A": "Days left",
              "Value #B": "Autorenew"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Days left",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "green",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Autorenew"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No",
                        "color": "orange",
                        "index": 0
                      },
                      "1": {
                        "text": "Yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Gandi prepaid balance",
      "type": "stat",
      "datasource": "${datasource}",
      "description": "Prepaid balance next to the warning threshold set in the Gandi account.",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_gandi_prepaid_balance",
          "legendFormat": "Balance ({{currency}})"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "yagura_gandi_prepaid_warning_threshold",
          "legendFormat": "Warning threshold ({{currency}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "title": "Costs",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Scaleway month to date by project",
      "type": "barchart",
      "datasource": "${datasource}",
      "description": "Scaleway consumption since the 1st of the month, per project and currency, stacked by category. Resets on the 1st. A project shows as its name and the first 8 characters of its ID, or its full ID when it has no name; replicas of the same exporter are counted once, and an instance whose last poll failed is left out. VAT inclusion is not confirmed: see the README.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 16,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (project, category, currency) (label_join(label_replace(label_replace(label_replace(label_replace(label_join(max by (project_id, project_name, category, currency) (yagura_scaleway_consumption_amount and on (job, instance) (yagura_collector_up{collector=\"scaleway_consumption\"} == 1)), \"name_id\", \";\", \"project_name\", \"project_id\"), \"project\", \"$1\", \"name_id\", \"(.+);\"), \"project\", \"$1 ($2)\", \"name_id\", \"(.+);(.{1,8}).*\"), \"project\", \"$1\", \"name_id\", \";(.+)\"), \"project\", \"(no project)\", \"name_id\", \";\"), \"project\", \" \", \"project\", \"currency\"))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "project",
            "columnField": "category",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Scaleway month to date total",
      "type": "stat",
      "datasource": "${datasource}",
      "description": "Scaleway consumption since the 1st of the month, per currency, all watched organizations together. Resets on the 1st. Replicas of the same exporter are counted once, and an instance whose last poll failed is left out.",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (currency) (max by (project_id, project_name, category, currency) (yagura_scaleway_consumption_amount and on (job, instance) (yagura_collector_up{collector=\"scaleway_consumption\"} == 1)))",
          "legendFormat": "{{currency}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    }
  ]
}
