    {
      "id": 21,
      "title": "Netlify build minutes",
      "type": "table",
      "datasource": "${datasource}",
      "description": "Build minutes used by each team in the current billing period, against the minutes included in its plan. Orange from 80% of the allowance, red once it is used up. A plan with no numeric allowance leaves Included and Used share empty. An exporter instance whose last poll failed is left out.",
      "gridPos": {
        "x": 14,
        "y": 50,
        "w": 10,
        "h": 8
