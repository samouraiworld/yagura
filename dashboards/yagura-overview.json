{
  "uid": "yagura-overview",
  "title": "yagura",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "yagura"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Exporter health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Collectors up",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Last success age",
      "type": "table",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "time() - yagura_collector_last_success_timestamp_seconds",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Item errors",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_last_item_errors"
        }
      ]
    },
    {
      "id": 5,
      "title": "API requests by code",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (provider, code) (rate(yagura_api_requests_total[5m]))",
          "legendFormat": "{{provider}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
