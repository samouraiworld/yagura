{
  "uid": "yagura-overview",
  "title": "yagura",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "yagura"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Exporter health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Collectors up",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Last success age",
      "type": "table",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "time() - yagura_collector_last_success_timestamp_seconds",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Item errors",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_collector_last_item_errors"
        }
      ]
    },
    {
      "id": 5,
      "title": "API requests by code",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "sum by (provider, code) (rate(yagura_api_requests_total[5m]))",
          "legendFormat": "{{provider}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Provider status",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Provider indicator",
      "type": "state-timeline",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_statuspage_indicator",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "unknown",
                  "color": "purple",
                  "index": 0
                },
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                },
                "1": {
                  "text": "minor",
                  "color": "yellow",
                  "index": 2
                },
                "2": {
                  "text": "major",
                  "color": "orange",
                  "index": 3
                },
                "3": {
                  "text": "critical",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Unresolved incidents",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "yagura_statuspage_unresolved_incidents",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
